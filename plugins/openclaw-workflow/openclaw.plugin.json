{
  "id": "genuineknowledge-workflow",
  "name": "Dynamic Workflow",
  "description": "Run and manage FusionFlow workflows from OpenClaw.",
  "contracts": {
    "tools": ["run_flow", "run_flow_resume", "flow_manage"]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "toolCommand": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string"}
      },
      "workspace": {"type": "string"},
      "runtimeRoot": {"type": "string"},
      "python": {"type": "string"}
    }
  }
}
